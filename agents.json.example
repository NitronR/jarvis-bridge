{
  "backends": [
    { "name": "opencode", "kind": "opencode", "command": "opencode", "args": ["acp"], "env": {} },
    {
      "name": "claude",
      "kind": "claude-acp",
      "command": "npx",
      "args": ["-y", "@agentclientprotocol/claude-agent-acp@latest"],
      "env": {}
    },
    {
      "name": "antigravity",
      "kind": "antigravity-acp",
      "command": "agy-acp",
      "args": [],
      "env": {}
    },
    {
      "name": "codex",
      "kind": "codex-acp",
      "command": "npx",
      "args": ["-y", "@agentclientprotocol/codex-acp@latest"],
      "env": {}
    }
  ]
}
